      },
      {
        "cell": "A4",
        "value": "Alt+F11 > Insertar > Módulo > pegue el código > guarde como .xlsm > clic derecho en cada forma > Asignar macro.",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A6",
        "value": "Option Explicit",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A7",
        "value": "Sub Cotizar()",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A8",
        "value": "    Dim w As Worksheet",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A9",
        "value": "    Set w = ThisWorkbook.Worksheets(\"Cotizador\")",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A10",
        "value": "    If w.Range(\"B6\").Value = \"\" Or w.Range(\"B7\").Value = \"\" Then",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A11",
        "value": "        MsgBox \"Seleccione Origen y Destino.\", vbExclamation: Exit Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A12",
        "value": "    End If",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A13",
        "value": "    If WorksheetFunction.Sum(w.Range(\"B8:B10\")) = 0 Then",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A14",
        "value": "        MsgBox \"Ingrese por lo menos un contenedor.\", vbExclamation: Exit Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A15",
        "value": "    End If",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A16",
        "value": "    Application.CalculateFull",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A17",
        "value": "    If w.Range(\"E9\").Value = 0 Then",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A18",
        "value": "        MsgBox \"No hay tarifa para esta combinación de ruta/equipo.\", vbInformation",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A19",
        "value": "    Else",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A20",
        "value": "        MsgBox \"Cotización calculada. Mejor agente: \" & w.Range(\"E7\").Value, vbInformation",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A21",
        "value": "    End If",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A22",
        "value": "End Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A24",
        "value": "Sub GuardarHistorico()",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A25",
        "value": "    Dim c As Worksheet, h As Worksheet, t As ListObject, r As ListRow",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A26",
        "value": "    Set c = Sheets(\"Cotizador\"): Set h = Sheets(\"Historico\"): Set t = h.ListObjects(\"tblHistorico\")",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A27",
        "value": "    Application.CalculateFull",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A28",
        "value": "    If c.Range(\"E9\").Value <= 0 Then MsgBox \"Primero genere una cotización válida.\", vbExclamation: Exit Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A29",
        "value": "    If t.ListRows.Count = 1 And WorksheetFunction.CountA(t.ListRows(1).Range) = 0 Then Set r = t.ListRows(1) Else Set r = t.ListRows.Add",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A30",
        "value": "    With r.Range",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A31",
        "value": "        .Cells(1, 1) = c.Range(\"B5\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A32",
        "value": "        .Cells(1, 2) = c.Range(\"B6\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A33",
        "value": "        .Cells(1, 3) = c.Range(\"B7\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A34",
        "value": "        .Cells(1, 4) = c.Range(\"B8\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A35",
        "value": "        .Cells(1, 5) = c.Range(\"B9\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A36",
        "value": "        .Cells(1, 6) = c.Range(\"B10\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A37",
        "value": "        .Cells(1, 7) = c.Range(\"B12\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A38",
        "value": "        .Cells(1, 8) = c.Range(\"E7\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A39",
        "value": "        .Cells(1, 9) = c.Range(\"E8\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A40",
        "value": "        .Cells(1, 10) = c.Range(\"E9\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A41",
        "value": "        .Cells(1, 11) = c.Range(\"E11\").Value",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A42",
        "value": "    End With",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A43",
        "value": "    MsgBox \"Cotización guardada en Histórico.\", vbInformation",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A44",
        "value": "End Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A46",
        "value": "Sub Limpiar()",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A47",
        "value": "    With Sheets(\"Cotizador\")",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A48",
        "value": "        .Range(\"B6:B12\").ClearContents",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A49",
        "value": "        .Range(\"B5\").Value = Date",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A50",
        "value": "        .Range(\"B8:B11\").Value = 0",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A51",
        "value": "        .Range(\"B11\").Value = 1",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A52",
        "value": "    End With",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A53",
        "value": "End Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A56",
        "value": "MACROS NUEVAS: CARGAR ARCHIVOS Y TOTALIZAR GASTOS EN DESTINO",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A58",
        "value": "Sub CargarArchivos()",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A59",
        "value": "    Dim fd As FileDialog, ruta As String, archivo As String",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A60",
        "value": "    Dim wbO As Workbook, wsO As Worksheet, loO As ListObject",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A61",
        "value": "    Dim wsT As Worksheet, loT As ListObject, nueva As ListRow",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A62",
        "value": "    Dim fila As ListRow, agente As String",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A63",
        "value": "    Dim totalArchivos As Long, totalFilas As Long",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A65",
        "value": "    Set fd = Application.FileDialog(msoFileDialogFolderPicker)",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A66",
        "value": "    With fd",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A67",
        "value": "        .Title = \"Seleccione la carpeta con los tarifarios estandarizados\"",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A68",
        "value": "        If .Show <> -1 Then Exit Sub",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A69",
        "value": "        ruta = .SelectedItems(1) & \"\\\"",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A70",
        "value": "    End With",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A72",
        "value": "    Application.ScreenUpdating = False",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A73",
        "value": "    Application.EnableEvents = False",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A74",
        "value": "    Set wsT = ThisWorkbook.Worksheets(\"Tarifas\")",
        "type": "s",
        "format": "General"
      },
      {
        "cell": "A75",
        "value": "    Set loT = wsT.ListObjects(\"tblTarifas\")",
        "type": "s",
        "format": "General"
      }
